#
# Serial flasher config
#

CONFIG_FREERTOS_ENABLE_BACKWARD_COMPATIBILITY=y
# 允许任务栈放到外部 RAM（audio_task 等大任务）
CONFIG_FREERTOS_TASK_CREATE_ALLOW_EXT_MEM=y

#
# SPI RAM config
#
CONFIG_SPIRAM=y
CONFIG_SPIRAM_BOOT_INIT=y
CONFIG_SPIRAM_USE_MALLOC=y
CONFIG_SPIRAM_SPEED_80M=y
CONFIG_SPIRAM_ALLOW_STACK_EXTERNAL_MEMORY=y
CONFIG_SPIRAM_TRY_ALLOCATE_WIFI_LWIP=y
CONFIG_SPIRAM_TRY_ALLOCATE_WIFI_LWIP=y
CONFIG_SPIRAM_MALLOC_RESERVE_INTERNAL=32768
# 关键：小对象（<=1024 字节）留内部 DRAM，大对象分配去 PSRAM
# 防止 semaphore、DMA 描述符、WiFi 管理结构被挤到 PSRAM 导致崩溃
CONFIG_SPIRAM_MALLOC_ALWAYSINTERNAL=1024

# Increase default app partition size to accommodate console example
# by providing new partition table in "partitions_dlna_example.csv"
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions_dlna_example.csv"

CONFIG_ESP_TLS_INSECURE=y
CONFIG_ESP_TLS_SKIP_SERVER_CERT_VERIFY=y

CONFIG_ESP_SYSTEM_EVENT_TASK_STACK_SIZE=3072

#
# Audio HAL
#
CONFIG_AUDIO_BOARD_CUSTOM=y

#
# === LwIP / TCP 网络优化（HTTP 音频流更流畅，抄自 airplay-esp32）===
#
CONFIG_LWIP_MAX_SOCKETS=16
CONFIG_LWIP_MSS=1460
# TCP 发送/接收窗口大小（较大以提升吞吐）
CONFIG_LWIP_TCP_WND_DEFAULT=11680
CONFIG_LWIP_TCP_SND_BUF_DEFAULT=11680
CONFIG_LWIP_SO_RCVBUF=y
CONFIG_LWIP_SO_REUSE=y
CONFIG_LWIP_TCP_RECVMBOX_SIZE=12
CONFIG_LWIP_UDP_RECVMBOX_SIZE=6
CONFIG_LWIP_TCP_KEEP_CONNECTION_WHEN_IP_CHANGES=y
CONFIG_LWIP_IPV4=y
CONFIG_LWIP_ICMP=y
CONFIG_LWIP_TCP_MAXRTX=12
CONFIG_LWIP_TCP_SYNMAXRTX=6
# TCP Window scaling：提升吞吐
CONFIG_LWIP_WND_SCALE=y
CONFIG_LWIP_RCV_WND_SCALE_FACTOR=2

#
# === HTTP server（custom_dlna）相关 ===
#
CONFIG_HTTPD_MAX_REQ_HDR_LEN=1024
CONFIG_HTTPD_MAX_URI_LEN=512
CONFIG_HTTPD_ERR_RESP_NO_KEY_RETURN_ONFAIL=n

#
# === WiFi 802.11 吞吐优化（抄自 airplay-esp32）===
#
CONFIG_ESP_WIFI_STATIC_RX_BUFFER_NUM=16
CONFIG_ESP_WIFI_DYNAMIC_RX_BUFFER_NUM=64
CONFIG_ESP_WIFI_STATIC_TX_BUFFER=n
CONFIG_ESP_WIFI_DYNAMIC_TX_BUFFER_NUM=64
CONFIG_ESP32_WIFI_AMPDU_TX_ENABLED=y
CONFIG_ESP32_WIFI_AMPDU_RX_ENABLED=y
CONFIG_ESP32_WIFI_NVS_ENABLED=y
CONFIG_ESP32_WIFI_TASK_PINNED_TO_CORE_0=y
CONFIG_ESP32S3_WIFI_NVS_ENABLED=y

#
# === mDNS（可选，方便发现设备；与 SSDP 共存无冲突）===
#
CONFIG_MDNS_MAX_SERVICES=10
CONFIG_MDNS_TASK_CREATE_FROM_SPIRAM=y
CONFIG_MDNS_MEMORY_ALLOC_SPIRAM=y

#
# === FreeRTOS tick / 任务调度优化 ===
#
CONFIG_FREERTOS_HZ=1000
CONFIG_FREERTOS_USE_TICKLESS_IDLE=n
CONFIG_FREERTOS_CHECK_STACKOVERFLOW_CANARY=y

#
# === 编译器优化（-O2 性能优先，音频播放更稳）===
#
CONFIG_COMPILER_OPTIMIZATION_PERF=y

#
# === CPU 频率与日志级别 ===
#
CONFIG_LOG_DEFAULT_LEVEL=3
CONFIG_LOG_COLORS=y
CONFIG_ESP32S3_DEFAULT_CPU_FREQ_240=y
CONFIG_ESP_DEFAULT_CPU_FREQ_MHZ=240

#
# === Flash 模式（esp32s3 qio + 80MHz）===
#
CONFIG_ESPTOOLPY_FLASHMODE_QIO=y
CONFIG_ESPTOOLPY_FLASHMODE="qio"
CONFIG_ESPTOOLPY_FLASHFREQ_80M=y
CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y